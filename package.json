{
  "name": "edubridge",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.18.2",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "web:dev": "pnpm --filter web dev",
    "web:build": "pnpm --filter web build",
    "web:start": "pnpm --filter web start",
    "web:lint": "pnpm --filter web lint",
    "api:dev": "pnpm --filter api dev",
    "api:build": "pnpm --filter api build",
    "api:start": "pnpm --filter api start",
    "api:lint": "pnpm --filter api lint",
    "build": "pnpm -r build",
    "start": "pnpm -r --parallel start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:rebuild": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:stop": "docker compose stop",
    "docker:start": "docker compose start",
    "docker:restart": "docker compose restart",
    "docker:logs": "docker compose logs -f",
    "docker:logs:api": "docker compose logs -f api",
    "docker:logs:web": "docker compose logs -f web",
    "docker:ps": "docker compose ps",
    "docker:clean": "docker compose down -v",
    "docker:reset": "docker compose down -v --remove-orphans",
    "db:generate": "pnpm --filter api run prisma:generate",
    "db:migrate": "pnpm --filter api run prisma:migrate",
    "db:deploy": "pnpm --filter api prisma migrate deploy",
    "db:reset": "pnpm --filter api prisma migrate reset",
    "db:seed": "pnpm --filter api prisma db seed",
    "db:seed:teachers": "pnpm --filter api db:seed:teachers",
    "db:seed:academic": "pnpm --filter api db:seed:academic",
    "db:seed:students": "pnpm --filter api db:seed:students",
    "db:studio": "pnpm --filter api prisma studio",
    "db:push": "pnpm --filter api prisma db push",
    "db:pull": "pnpm --filter api prisma db pull",
    "db:format": "pnpm --filter api prisma format",
    "db:validate": "pnpm --filter api run prisma:validate",
    "db:clean": "pnpm --filter api db:clean",
    "setup": "pnpm install",
    "prepare": "husky"
  },
  "pnpm": {
    "overrides": {
      "next": "16.3.8",
      "eslint-config-next": "16.3.8",
      "axios": "^1.20.0",
      "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
      "js-yaml": "^4.3.2",
      "fast-uri": "^3.1.8",
      "deepmerge-ts": "^8.0.0",
      "mysql2": "^3.22.0",
      "sharp": "^0.35.5",
      "proxy-addr": "^2.0.8",
      "source-map-js": "^1.2.2",
      "compression": "^1.8.2",
      "ip-address": "^10.7.1",
      "morgan": "^1.12.1",
      "multer": "^2.4.0",
      "qs": "^6.16.0"
    }
  },
  "devDependencies": {
    "husky": "^9.1.7"
  }
}
