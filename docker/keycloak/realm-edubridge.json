{
  "id": "edubridge",
  "realm": "edubridge",
  "displayName": "EduBridge Identity & Access Management",
  "displayNameHtml": "<div class=\"kc-logo-text\"><span>Edu</span>Bridge</div>",
  "notBefore": 0,
  "defaultSignatureAlgorithm": "RS256",
  "revokeRefreshToken": false,
  "refreshTokenMaxReuse": 0,
  "accessTokenLifespan": 1800,
  "accessTokenLifespanForImplicitFlow": 900,
  "ssoSessionIdleTimeout": 86400,
  "ssoSessionMaxLifespan": 604800,
  "offlineSessionIdleTimeout": 2592000,
  "offlineSessionMaxLifespanEnabled": false,
  "offlineSessionMaxLifespan": 5184000,
  "clientSessionIdleTimeout": 0,
  "clientSessionMaxLifespan": 0,
  "accessCodeLifespan": 60,
  "accessCodeLifespanUserAction": 300,
  "accessCodeLifespanLogin": 1800,
  "actionTokenGeneratedByAdminLifespan": 43200,
  "actionTokenGeneratedByUserLifespan": 300,
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "rememberMe": true,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "SYSTEM_ADMIN",
        "description": "National and global system administrator with full platform access"
      },
      {
        "name": "SCHOOL_ADMIN",
        "description": "School administrator with tenant management access"
      },
      {
        "name": "TEACHER",
        "description": "School educator and curriculum instructor"
      },
      {
        "name": "STUDENT",
        "description": "Enrolled student learner"
      },
      {
        "name": "PARENT",
        "description": "Student parent or guardian"
      }
    ]
  },
  "groups": [],
  "defaultRoles": [
    "offline_access",
    "uma_authorization"
  ],
  "clientScopes": [
    {
      "name": "edubridge-audience",
      "description": "Adds edubridge-api to token audience",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "edubridge-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "edubridge-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "defaultDefaultClientScopes": [
    "role_list",
    "profile",
    "email",
    "web-origins",
    "edubridge-audience"
  ],
  "clients": [
    {
      "id": "edubridge-web-client",
      "clientId": "edubridge-web",
      "name": "EduBridge Web Application",
      "description": "Frontend single page web application for students, teachers, and admins",
      "rootUrl": "http://localhost:3000",
      "adminUrl": "http://localhost:3000",
      "baseUrl": "http://localhost:3000",
      "surrogateAuthRequired": false,
      "enabled": true,
      "alwaysDisplayInConsole": false,
      "clientAuthenticatorType": "client-secret",
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:5000/*",
        "http://localhost:5000/api/auth/keycloak/callback",
        "https://edubridge-et.vercel.app/*"
      ],
      "webOrigins": [
        "*"
      ],
      "notBefore": 0,
      "bearerOnly": false,
      "consentRequired": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "publicClient": true,
      "frontchannelLogout": true,
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*##https://edubridge-et.vercel.app/*"
      },
      "fullScopeAllowed": true
    },
    {
      "id": "edubridge-api-client",
      "clientId": "edubridge-api",
      "name": "EduBridge Backend API",
      "description": "Backend API resource server verifying bearer tokens",
      "rootUrl": "http://localhost:5000",
      "baseUrl": "http://localhost:5000",
      "surrogateAuthRequired": false,
      "enabled": true,
      "alwaysDisplayInConsole": false,
      "clientAuthenticatorType": "client-secret",
      "redirectUris": [
        "http://localhost:5000/*"
      ],
      "webOrigins": [],
      "notBefore": 0,
      "bearerOnly": true,
      "consentRequired": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "publicClient": false,
      "frontchannelLogout": false,
      "protocol": "openid-connect",
      "attributes": {},
      "fullScopeAllowed": true
    }
  ],
  "users": [
    {
      "id": "e0000000-0000-0000-0000-000000000001",
      "username": "admin",
      "email": "admin@edubridge.com",
      "firstName": "System",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Admin@123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "SYSTEM_ADMIN"
      ]
    },
    {
      "id": "e0000000-0000-0000-0000-000000000002",
      "username": "teacher",
      "email": "teacher@edubridge.com",
      "firstName": "Abebe",
      "lastName": "Kebede",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Teacher@123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "TEACHER"
      ]
    },
    {
      "id": "e0000000-0000-0000-0000-000000000003",
      "username": "student",
      "email": "student@edubridge.com",
      "firstName": "Almaz",
      "lastName": "Tadesse",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Student@123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "STUDENT"
      ]
    }
  ]
}
