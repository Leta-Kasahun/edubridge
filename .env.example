POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=edubridge_db
POSTGRES_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_URL=redis://:your_redis_password@redis:6379

API_PORT=5000
WEB_PORT=3000

DATABASE_URL=postgresql://postgres:your_postgres_password@postgres:5432/edubridge_db

JWT_SECRET=your_jwt_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret
JWT_ACCESS_EXPIRES_IN=43200m
JWT_REFRESH_EXPIRES_IN=7d

BREVO_API_KEY=your_brevo_api_key
EMAIL_FROM=noreply@edubridge.com
EMAIL_FROM_NAME=Edubridge

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

B2_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
B2_REGION=eu-central-003
B2_BUCKET_NAME=edubridge-files-prod
B2_KEY_ID=your_b2_key_id
B2_APPLICATION_KEY=your_b2_application_key
B2_PUBLIC_URL_PREFIX=

NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_APP_NAME=EduBridge

# Allowed CORS origins (comma-separated for multiple, e.g. http://localhost:3000,https://edubridge-et.vercel.app)
CORS_ORIGIN=http://localhost:3000,https://edubridge-et.vercel.app

# Keycloak IAM configuration
KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB=edubridge_keycloak
KEYCLOAK_URL=http://localhost:8081
KEYCLOAK_REALM=edubridge
KEYCLOAK_CLIENT_ID=edubridge-api
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_CALLBACK_URL=http://localhost:5000/api/auth/keycloak/callback
KEYCLOAK_FRONTEND_CLIENT_ID=edubridge-web
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8081
NEXT_PUBLIC_KEYCLOAK_REALM=edubridge
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=edubridge-web


