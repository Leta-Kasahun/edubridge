// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum AccountStatus {
  PENDING_FIRST_LOGIN
  ACTIVE
  SUSPENDED
  LOCKED
  DEACTIVATED
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  LEFT
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
  SUSPICIOUS
}

enum DeviceType {
  WEB
  MOBILE
  TABLET
  DESKTOP_APP
}

enum FailureReason {
  INVALID_CREDENTIALS
  ACCOUNT_LOCKED
  ACCOUNT_SUSPENDED
  ACCOUNT_DEACTIVATED
  IP_BLOCKED
  RATE_LIMITED
  OTP_REQUIRED
  OTP_INVALID
  OTP_EXPIRED
}

enum OTPPurpose {
  LOGIN_2FA
  EMAIL_VERIFICATION
  EMAIL_CHANGE
  PASSWORD_RESET
  INVITATION_ACCEPT
}

enum SecurityEventType {
  BRUTE_FORCE_DETECTED
  ACCOUNT_LOCKED
  NEW_DEVICE
  NEW_LOCATION
  IMPOSSIBLE_TRAVEL
  SUSPICIOUS_LOGIN
  REFRESH_TOKEN_REUSE
  PASSWORD_CHANGED
  PASSWORD_RESET
  OTP_FAILED
  SESSION_REVOKED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum LookupCategory {
  POLICY
  FEATURE
  SETTING
  SECURITY
  NOTIFICATION
  INTEGRATION
  CUSTOM
}

model Tenant {
  id              String             @id @default(uuid()) @db.Uuid
  name            String
  code            String             @unique
  status          TenantStatus       @default(ACTIVE)

  memberships     TenantMembership[]
  roles           Role[]
  lookups         Lookup[]
  securityPolicy  SecurityPolicy?
  sessions        Session[]
  loginAttempts   LoginAttempt[]
  invitations     Invitation[]
  auditLogs       AuditLog[]
  securityEvents  SecurityEvent[]

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model User {
  id                      String             @id @default(uuid()) @db.Uuid
  username                String?            @unique
  email                   String?            @unique
  googleId                String?            @unique
  passwordHash            String?
  status                  AccountStatus      @default(PENDING_FIRST_LOGIN)
  emailVerified           Boolean            @default(false)
  pendingEmail            String?
  firstName               String
  lastName                String
  failedLoginAttempts     Int                @default(0)
  lockedUntil             DateTime?
  lastLoginAt             DateTime?
  lastLoginIp             String?
  passwordChangedAt       DateTime?

  memberships             TenantMembership[]
  otpCodes                OTPCode[]
  sessions                Session[]
  loginAttempts           LoginAttempt[]
  securityEvents          SecurityEvent[]
  auditLogs               AuditLog[]
  createdInvitations      Invitation[]       @relation("CreatedInvitations")
  resolvedSecurityEvents  SecurityEvent[]    @relation("ResolvedSecurityEvents")

  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  @@index([status])
}

model TenantMembership {
  id              String             @id @default(uuid()) @db.Uuid
  tenantId        String             @db.Uuid
  userId          String             @db.Uuid
  status          MembershipStatus   @default(ACTIVE)

  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles           MembershipRole[]

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId, status])
}

model Role {
  id                String             @id @default(uuid()) @db.Uuid
  tenantId          String             @db.Uuid
  name              String
  code              String
  description       String?
  isSystem          Boolean            @default(false)
  isActive          Boolean            @default(true)

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membershipRoles   MembershipRole[]
  permissions       RolePermission[]
  invitations       Invitation[]

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
}

model Permission {
  id                String             @id @default(uuid()) @db.Uuid
  code              String             @unique
  name              String
  description       String?
  resource          String
  action            String
  isActive          Boolean            @default(true)

  roles             RolePermission[]

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([resource, action])
}

model RolePermission {
  roleId            String             @db.Uuid
  permissionId      String             @db.Uuid

  role              Role               @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission        Permission         @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt         DateTime           @default(now())

  @@id([roleId, permissionId])
}

model MembershipRole {
  membershipId      String             @db.Uuid
  roleId            String             @db.Uuid

  membership        TenantMembership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role              Role               @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt        DateTime           @default(now())
  expiresAt         DateTime?

  @@id([membershipId, roleId])
  @@index([roleId])
}

model Lookup {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @db.Uuid
  category        LookupCategory
  key             String
  value           Json
  description     String?
  isActive        Boolean         @default(true)

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([tenantId, category, key])
  @@index([tenantId, category])
}

model SecurityPolicy {
  id                              String    @id @default(uuid()) @db.Uuid
  tenantId                        String    @unique @db.Uuid

  tenant                          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  minPasswordLength               Int       @default(12)
  maxPasswordLength               Int       @default(128)
  requireUppercase                Boolean   @default(true)
  requireLowercase                Boolean   @default(true)
  requireNumbers                  Boolean   @default(true)
  requireSpecialChars             Boolean   @default(true)
  passwordExpiryDays              Int       @default(0)
  forcePasswordChangeAfterReset   Boolean   @default(true)

  maxFailedAttempts               Int       @default(5)
  failedAttemptWindowMinutes      Int       @default(15)
  lockoutDurationMinutes          Int       @default(15)

  otpEnabled                      Boolean   @default(false)
  otpExpiryMinutes                Int       @default(5)
  otpMaxAttempts                  Int       @default(5)
  otpResendCooldownSeconds        Int       @default(30)
  otpMaxResendPerHour             Int       @default(5)
  requireOtpForLogin              Boolean   @default(false)
  requireOtpForEmailChange        Boolean   @default(true)
  requireOtpForVerification       Boolean   @default(true)

  accessTokenExpiryMinutes        Int       @default(15)
  refreshTokenExpiryDays          Int       @default(7)
  maxConcurrentSessions           Int       @default(5)
  sessionTimeoutMinutes           Int       @default(60)
  revokeSessionsOnPasswordChange  Boolean   @default(true)

  detectSuspiciousLogin           Boolean   @default(true)
  notifyOnNewDevice               Boolean   @default(true)

  allowGoogleAuth                 Boolean   @default(true)

  createdAt                       DateTime  @default(now())
  updatedAt                       DateTime  @updatedAt
}

model OTPCode {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String       @db.Uuid
  codeHash          String
  purpose           OTPPurpose
  expiresAt         DateTime
  consumedAt        DateTime?
  attemptCount      Int          @default(0)

  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt         DateTime     @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
}

model Session {
  id                String          @id @default(uuid()) @db.Uuid
  tenantId          String          @db.Uuid
  userId            String          @db.Uuid
  refreshTokenHash  String          @unique
  status            SessionStatus   @default(ACTIVE)
  deviceId          String
  deviceType        DeviceType      @default(WEB)
  ipAddress         String
  userAgent         String?
  lastUsedAt        DateTime        @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?
  revokeReason      String?

  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  securityEvents    SecurityEvent[]

  createdAt         DateTime        @default(now())

  @@index([userId, status])
  @@index([tenantId, userId, status])
  @@index([expiresAt])
}

model LoginAttempt {
  id                String          @id @default(uuid()) @db.Uuid
  tenantId          String?         @db.Uuid
  userId            String?         @db.Uuid
  identifier        String
  ipAddress         String
  userAgent         String?
  deviceId          String?
  success           Boolean         @default(false)
  failureReason     FailureReason?

  tenant            Tenant?         @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user              User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt         DateTime        @default(now())

  @@index([identifier, createdAt])
  @@index([ipAddress, createdAt])
  @@index([userId, createdAt])
}

model SecurityEvent {
  id                String             @id @default(uuid()) @db.Uuid
  tenantId          String?            @db.Uuid
  userId            String?            @db.Uuid
  sessionId         String?            @db.Uuid
  type              SecurityEventType
  riskLevel         RiskLevel          @default(LOW)
  ipAddress         String?
  description       String?
  metadata          Json?
  isResolved        Boolean            @default(false)
  resolvedAt        DateTime?
  resolvedById      String?            @db.Uuid

  tenant            Tenant?            @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user              User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  session           Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  resolvedBy        User?              @relation("ResolvedSecurityEvents", fields: [resolvedById], references: [id], onDelete: SetNull)

  createdAt         DateTime           @default(now())

  @@index([userId, createdAt])
  @@index([riskLevel, isResolved])
  @@index([type, createdAt])
}

model Invitation {
  id                String             @id @default(uuid()) @db.Uuid
  tenantId          String             @db.Uuid
  email             String
  roleId            String?            @db.Uuid
  tokenHash         String             @unique
  status            InvitationStatus   @default(PENDING)
  expiresAt         DateTime
  acceptedAt        DateTime?
  createdById       String             @db.Uuid

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role              Role?              @relation(fields: [roleId], references: [id], onDelete: SetNull)
  createdBy         User               @relation("CreatedInvitations", fields: [createdById], references: [id])

  createdAt         DateTime           @default(now())

  @@index([tenantId, email])
  @@index([expiresAt])
  @@index([createdById])
}

model AuditLog {
  id                String       @id @default(uuid()) @db.Uuid
  tenantId          String?      @db.Uuid
  userId            String?      @db.Uuid
  action            String
  resource          String
  resourceId        String?      @db.Uuid
  metadata          Json?
  ipAddress         String?

  tenant            Tenant?      @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user              User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt         DateTime     @default(now())

  @@index([tenantId, action])
  @@index([userId, createdAt])
  @@index([resource, resourceId])
}