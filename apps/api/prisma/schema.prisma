  @@index([studentId, objectiveId, observedAt])
  @@index([assessmentId])
  @@index([attemptId])
  @@index([questionVersionId])
}

model StudentTopicPerformance {
  id String @id @default(uuid()) @db.Uuid

  tenantId  String @db.Uuid
  studentId String @db.Uuid
  topicId   String @db.Uuid

  questionCount   Int @default(0)
  correctCount    Int @default(0)
  incorrectCount  Int @default(0)

  pointsEarned Decimal @default(0) @db.Decimal(12, 2)
  pointsPossible Decimal @default(0) @db.Decimal(12, 2)

  accuracy Decimal? @db.Decimal(5, 2)

  lastObservedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topic CurriculumTopic @relation(fields: [topicId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, topicId])
  @@index([tenantId, studentId])
  @@index([studentId, topicId])
  @@index([topicId])
}

model StudentTopicMastery {
  id String @id @default(uuid()) @db.Uuid

  tenantId  String @db.Uuid
  studentId String @db.Uuid
  topicId   String @db.Uuid

  level MasteryLevel @default(NOT_STARTED)

  masteryScore Decimal? @db.Decimal(5, 2)

  evidenceCount Int @default(0)

  calculatedAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topic CurriculumTopic @relation(fields: [topicId], references: [id], onDelete: Restrict)

  history MasteryHistory[]

  @@unique([studentId, topicId])
  @@index([tenantId, studentId, level])
  @@index([studentId, topicId])
  @@index([topicId, level])
}

model MasteryHistory {
  id String @id @default(uuid()) @db.Uuid

  tenantId  String @db.Uuid
  studentId String @db.Uuid
  topicId   String @db.Uuid

  masteryId String? @db.Uuid

  level MasteryLevel

  masteryScore Decimal? @db.Decimal(5, 2)

  evidenceCount Int

  calculatedAt DateTime @default(now())

  calculationVersion String?

  metadata Json?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topic CurriculumTopic @relation(fields: [topicId], references: [id], onDelete: Restrict)
  mastery StudentTopicMastery? @relation(fields: [masteryId], references: [id], onDelete: SetNull)

  @@index([studentId, topicId, calculatedAt])
  @@index([tenantId, studentId, calculatedAt])
}

// ============================================================
// NOTIFICATIONS
// ============================================================

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

enum NotificationStatus {
  PENDING
  QUEUED
  SENT
  DELIVERED
  FAILED
  BOUNCED
}

enum NotificationCategory {
  ACADEMIC
  ASSESSMENT
  CONTENT
  TEACHER
  SECURITY
  SYSTEM
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Notification {
  id         String               @id @default(uuid()) @db.Uuid
  tenantId   String               @db.Uuid
  userId     String               @db.Uuid

  category   NotificationCategory
  priority   NotificationPriority @default(NORMAL)

  title      String
  body       String
  actionUrl  String?
  metadata   Json?

  isRead     Boolean              @default(false)
  readAt     DateTime?

  sourceType String?
  sourceId   String?              @db.Uuid

  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  deliveries NotificationDelivery[]

  createdAt  DateTime             @default(now())

  @@index([tenantId, userId, isRead])
  @@index([userId, createdAt])
  @@index([tenantId, category, createdAt])
  @@index([sourceType, sourceId])
}

model NotificationDelivery {
  id             String              @id @default(uuid()) @db.Uuid
  notificationId String              @db.Uuid

  channel        NotificationChannel
  status         NotificationStatus  @default(PENDING)

  providerRef    String?

  attemptCount   Int                 @default(0)
  errorMessage   String?

  queuedAt       DateTime?
  sentAt         DateTime?
  deliveredAt    DateTime?
  failedAt       DateTime?

  notification   Notification        @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([notificationId])
  @@index([status, channel])
  @@index([channel, status, createdAt])
}

model NotificationPreference {
  id         String               @id @default(uuid()) @db.Uuid
  userId     String               @db.Uuid

  category   NotificationCategory
  channel    NotificationChannel
  enabled    Boolean              @default(true)

  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@unique([userId, category, channel])
  @@index([userId])
}

// ============================================================
// STUDENT BOOKMARKS
// ============================================================

enum BookmarkTargetType {
  QUESTION
  TOPIC
  LEARNING_CONTENT
}

model StudentBookmark {
  id         String             @id @default(uuid()) @db.Uuid
  tenantId   String             @db.Uuid
  studentId  String             @db.Uuid

  targetType BookmarkTargetType
  targetId   String             @db.Uuid

  note       String?            @db.VarChar(500)
  metadata   Json?

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student    StudentProfile     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([studentId, targetType, targetId])
  @@index([tenantId, studentId, targetType])
  @@index([tenantId, targetType, targetId])
}

