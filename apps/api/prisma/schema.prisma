  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([createdById])
}

model ImportRow {
  id        String          @id @default(uuid()) @db.Uuid
  batchId   String          @db.Uuid
  rowNumber Int
  status    ImportRowStatus @default(PENDING)
  data      Json
  errors    Json?
  resultId  String?
