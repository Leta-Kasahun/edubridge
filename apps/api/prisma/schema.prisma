  @@index([tenantId, subjectId])
  @@index([tenantId, gradeId])
  @@index([tenantId, unitId])
  @@index([tenantId, gradeId, subjectId])
  @@index([tenantId, curriculumVersionId])
  @@index([tenantId, authorId])
  @@index([authorId])
  @@index([subjectId])
  @@index([gradeId])
  @@index([unitId])
  @@index([curriculumVersionId])
}

model ContentVersion {
